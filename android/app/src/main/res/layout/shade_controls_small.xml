<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed: [ − ]  rate  [ + ]. The rate sits between the buttons so the
     two targets are a whole rate-width apart and can't be confused, and the
     counter works even when the shade shows this notification collapsed.
     48dp is the collapsed custom-content height on Android 12+. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/shade_reject"
        android:layout_width="88dp"
        android:layout_height="48dp"
        android:background="@drawable/shade_btn_reject"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="−"
        android:textColor="@color/shade_crimson"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/shade_rate"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:autoSizeMaxTextSize="24sp"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeTextType="uniform"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/shade_accept"
        android:layout_width="88dp"
        android:layout_height="48dp"
        android:background="@drawable/shade_btn_accept"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="+"
        android:textColor="@color/shade_emerald"
        android:textSize="34sp"
        android:textStyle="bold" />
</LinearLayout>
