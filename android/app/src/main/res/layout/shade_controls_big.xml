<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded: [  −  ]   rate   [  +  ], the same order as the overlay pill.
     Tall pill buttons with large glyphs, the tinted rate dead-centre between
     them as the spacer, and the counts underneath. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/shade_reject"
            android:layout_width="100dp"
            android:layout_height="80dp"
            android:background="@drawable/shade_btn_reject"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="−"
            android:textColor="@color/shade_crimson"
            android:textSize="46sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/shade_rate"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:autoSizeMaxTextSize="34sp"
                android:autoSizeMinTextSize="18sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shade_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />
        </LinearLayout>

        <TextView
            android:id="@+id/shade_accept"
            android:layout_width="100dp"
            android:layout_height="80dp"
            android:background="@drawable/shade_btn_accept"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="+"
            android:textColor="@color/shade_emerald"
            android:textSize="46sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/shade_counts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />
</LinearLayout>
