# =====================================================================
#  PUBLIC REPO — anything personal or secret must match a rule below.
#  Before every commit: `git status --short` and check nothing new shows.
# =====================================================================

# ---------------------------------------------------------------------
# Secrets & personal values (CRITICAL)
# ---------------------------------------------------------------------

# Compile-time defines: WhatsApp contact, ORLEN_API_URL. Any variant
# (dart_defines.prod.json, dart_defines.local.json, …) stays local.
dart_defines*.json
!dart_defines.example.json

# Android release signing
key.properties
**/key.properties
*.jks
**/*.jks
*.keystore
**/*.keystore
*.p12
**/*.p12
*.pfx
**/*.pfx
*.pem
**/*.pem
*.key
**/*.key

# Envied secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
lib/env.g.dart
**/env.g.dart

# Firebase / Google service configs and service-account keys
google-services.json
**/google-services.json
GoogleService-Info.plist
**/GoogleService-Info.plist
service-account*.json
**/service-account*.json
client_secret*.json
**/client_secret*.json

# Cloudflare Worker (backend/orlen-worker): the Telegram bot token, webhook
# secret, and admin chat id live in `wrangler secret`, never in files.
# `.dev.vars` is Wrangler's local secrets file.
.dev.vars
.dev.vars.*
**/.dev.vars
**/.dev.vars.*
.wrangler/
**/.wrangler/
node_modules/
**/node_modules/

# Generic secret drops
secrets/
**/secrets/
*.secret
**/*.secret

# ---------------------------------------------------------------------
# Local tooling & private notes
# ---------------------------------------------------------------------

# Cursor / agent notes — local only
.cursor/
.cursorrules
agent-learnings.md
handoff.md
canvases/

# Maintainer-only release notes
release/YAYIN_TR.md

# IDEs (IntelliJ, VS Code)
*.iml
*.ipr
*.iws
.idea/
.vscode/

# OS / editor junk
*.class
*.log
*.pyc
*.swp
*.orig
*.rej
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Ad-hoc dumps — regenerate locally; never commit
deps.txt
**/deps.txt
requirements.txt

# ---------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------

# Flutter / Dart / Pub
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
**/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
**/build/
/coverage/
.test_runner/

# Android
.gradle/
**/.gradle/
**/.kotlin/
**/*.salive
**/.cxx/
**/local.properties
**/captures/
**/output.json
*.dex
/android/app/debug
/android/app/profile
/android/app/release

# iOS / macOS
ios/Pods/
ios/.symlinks/
macos/Pods/
macos/Flutter/ephemeral/

# Binaries
*.apk
*.aab
*.zip

# Obfuscation symbols (--split-debug-info=symbols/)
app.*.symbols
app.*.map.json
symbols/
**/symbols/

# JVM / native crash dumps
*.hprof
